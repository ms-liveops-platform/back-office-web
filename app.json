{
  "name": "back-office-web",
  "description": "LiveOps demo back-office-web",
  "stack": "heroku-24",
  "buildpacks": [
    {
      "url": "heroku/nodejs"
    }
  ],
  "formation": {
    "web": {
      "quantity": 1
    }
  },
  "env": {
    "NODE_ENV": {
      "value": "production"
    },
    "HOST": {
      "value": "0.0.0.0"
    },
    "VITE_API_URL": {
      "description": "https://YOUR-API-HOST/api/back-office (public build-time URL).",
      "required": true
    },
    "VITE_GAME_URL": {
      "description": "https://YOUR-GAMES-HOST (public build-time URL).",
      "required": true
    }
  }
}
